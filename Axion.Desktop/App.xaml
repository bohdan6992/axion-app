<Application x:Class="Axion.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- =======================
         THEME: Dark (AxiON)
         ======================= -->

    <!-- Palette -->
    <Color x:Key="BgColor">#0B0F14</Color>
    <Color x:Key="PanelColor">#111826</Color>
    <Color x:Key="Panel2Color">#0E1520</Color>
    <Color x:Key="BorderColor">#233041</Color>

    <Color x:Key="TextColor">#E6EDF3</Color>
    <Color x:Key="MutedTextColor">#9AA6B2</Color>

    <Color x:Key="AccentOrangeColor">#FF8A00</Color>
    <Color x:Key="AccentBlueColor">#2F81F7</Color>

    <Color x:Key="GoodGreenColor">#22C55E</Color>
    <Color x:Key="DangerRedColor">#EF4444</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="Panel2" Color="{StaticResource Panel2Color}"/>
    <SolidColorBrush x:Key="BorderBrush1" Color="{StaticResource BorderColor}"/>

    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedTextColor}"/>

    <SolidColorBrush x:Key="AccentOrange" Color="{StaticResource AccentOrangeColor}"/>
    <SolidColorBrush x:Key="AccentBlue" Color="{StaticResource AccentBlueColor}"/>

    <SolidColorBrush x:Key="GoodGreen" Color="{StaticResource GoodGreenColor}"/>
    <SolidColorBrush x:Key="DangerRed" Color="{StaticResource DangerRedColor}"/>

    <!-- Subtle glow brushes (used for focus/hover) -->
    <SolidColorBrush x:Key="GlowOrange" Color="#33FF8A00"/>
    <SolidColorBrush x:Key="GlowBlue" Color="#332F81F7"/>
    <SolidColorBrush x:Key="GlowGreen" Color="#3322C55E"/>
    <SolidColorBrush x:Key="GlowRed" Color="#33EF4444"/>

    <!-- Default window text -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- =======================
         INPUTS
         ======================= -->

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOrange}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOrange}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- =======================
         BUTTONS
         ======================= -->

    <!-- Base button template -->
    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14"
                    SnapsToDevicePixels="True">
              <Border.Effect>
                <DropShadowEffect Opacity="0.22"
                                  BlurRadius="18"
                                  ShadowDepth="0"
                                  Color="#000000"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.95"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
              </Trigger>

              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>

              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Default buttons -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

    <!-- Secondary -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
    </Style>

    <!-- Accent (Update) -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#1A2332"/>
      <Setter Property="BorderBrush" Value="#2E3B52"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentOrange}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Start / Stop primary -->
    <Style x:Key="PrimaryGreenButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#12301F"/>
      <Setter Property="BorderBrush" Value="#1D5C3A"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource GoodGreen}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryRedButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#33161A"/>
      <Setter Property="BorderBrush" Value="#6B1F2A"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource DangerRed}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- =======================
         CARDS / TILES
         ======================= -->

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Opacity="0.30" BlurRadius="22" ShadowDepth="0" Color="#000000"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

  </Application.Resources>
</Application>
