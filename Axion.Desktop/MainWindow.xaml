<Window ... Background="{StaticResource Bg}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Axion LOCAL" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource MutedText}" Margin="0,6,0,0"/>
    </StackPanel>

    <!-- Controls card -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush1}"
            BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <UniformGrid Columns="4" Margin="0,0,0,8">
          <Button Content="Start API" Command="{Binding StartApiCommand}" Margin="0,0,10,0"/>
          <Button Content="Stop API" Command="{Binding StopApiCommand}" Margin="0,0,10,0"/>
          <Button Content="Open Swagger" Command="{Binding OpenSwaggerCommand}" Margin="0,0,10,0"/>
          <Button Content="Update App" Command="{Binding UpdateAppCommand}"/>
        </UniformGrid>

        <!-- Optional: hide login block for now -->
        <!-- If you keep it, wrap it in another Border as a secondary panel -->
      </StackPanel>
    </Border>

    <!-- Log card -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush1}"
            BorderThickness="1" CornerRadius="14" Padding="12">
      <TextBox Text="{Binding LogText}" IsReadOnly="True" BorderThickness="0"
               Background="Transparent" VerticalScrollBarVisibility="Auto"/>
    </Border>

  </Grid>
</Window>
