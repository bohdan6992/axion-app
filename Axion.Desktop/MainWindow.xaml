<Window x:Class="Axion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Axion" Height="780" Width="1100"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Axion LOCAL" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Launcher • API • GitHub Signals"
                 Foreground="{StaticResource MutedText}" Margin="0,6,0,0"/>
    </StackPanel>

    <!-- Controls card -->
    <Border Grid.Row="1"
            Background="{StaticResource Panel}"
            BorderBrush="{StaticResource BorderBrush1}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16"
            Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Buttons + Login -->
        <StackPanel Grid.Column="0" Margin="0,0,14,0">

          <UniformGrid Columns="2" Margin="0,0,0,10">
            <Button Content="Start API" Margin="0,0,10,10" Click="StartApi_Click"/>
            <Button Content="Stop API" Margin="0,0,0,10" Click="StopApi_Click"/>
            <Button Content="Open Swagger" Margin="0,0,10,0" Click="OpenSwagger_Click"/>
            <Button x:Name="UpdateAppBtn" Content="Update App" Click="UpdateApp_Click"/>
          </UniformGrid>

          <!-- Login card (можна лишити; зараз просто best-effort) -->
          <Border Background="{StaticResource Bg}"
                  BorderBrush="{StaticResource BorderBrush1}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="12"
                  Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Login (optional)" FontWeight="SemiBold"/>
              <TextBlock Text="Used for future API auth flow."
                         Foreground="{StaticResource MutedText}" Margin="0,4,0,10"/>

              <TextBox x:Name="EmailBox" Height="34" VerticalContentAlignment="Center" />
              <PasswordBox x:Name="PasswordBox" Height="34" Margin="0,10,0,0"/>

              <Button Content="Login" Margin="0,10,0,0" Click="Login_Click"/>
            </StackPanel>
          </Border>

        </StackPanel>

        <!-- Right: Status -->
        <Border Grid.Column="1"
                Background="{StaticResource Bg}"
                BorderBrush="{StaticResource BorderBrush1}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
          <StackPanel>
            <TextBlock Text="Status" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Foreground="{StaticResource MutedText}"
                       Text="Live state + build + signals source." Margin="0,4,0,12"/>

            <Border Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource BorderBrush1}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,10">
              <TextBlock x:Name="ApiText" Text="API: unknown"/>
            </Border>

            <Border Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource BorderBrush1}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,10">
              <TextBlock x:Name="StatusText" Text="Status: unknown"/>
            </Border>

            <Border Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource BorderBrush1}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,10">
              <TextBlock x:Name="VersionText" Text="Version: unknown"/>
            </Border>

            <Border Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource BorderBrush1}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10">
              <TextBlock x:Name="SignalsText" Text="Signals: unknown" TextWrapping="Wrap"/>
            </Border>

          </StackPanel>
        </Border>

      </Grid>
    </Border>

    <!-- Log card -->
    <Border Grid.Row="2"
            Background="{StaticResource Panel}"
            BorderBrush="{StaticResource BorderBrush1}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Log" FontWeight="SemiBold" FontSize="14" Margin="2,0,0,10"/>

        <TextBox Grid.Row="1"
                 x:Name="LogBox"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"/>
      </Grid>
    </Border>

  </Grid>
</Window>
